# ============================================================
#  Domaine XXV — variáveis de ambiente
#  Copie para .env.local (local) ou cole na Vercel → Settings → Environment Variables
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.o-seu-dominio.pt   # sem barra no fim; usado nos links dos emails/SMS
NEXT_PUBLIC_SITE_VARIANT=B                           # etiqueta do teste A/B (aparece em cada lead)

# --- Base de dados (Neon / qualquer Postgres) --- OBRIGATÓRIA para guardar leads e o centro /leads
# Na Vercel: Storage → Create → Neon → Connect ao projeto. Preenche DATABASE_URL sozinho (não precisa de escrever nada).
# As tabelas são criadas sozinhas no primeiro pedido. Se a base de dados falhar, a lead é enviada na mesma por email.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Centro de leads (/leads) ---
ADMIN_PASSWORD=uma-palavra-passe-forte
ADMIN_SESSION_SECRET=gere-uma-string-aleatoria-longa    # ex.: openssl rand -base64 32

# --- Email (Resend) ---
# 1) resend.com → criar conta → API Keys → Create API Key
# 2) Domains → Add Domain → copiar os registos DNS para o seu domínio → Verify
#    (sem domínio verificado, o Resend só entrega emails ao endereço da própria conta Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="André Queirós · Domaine XXV <andre@o-seu-dominio.pt>"
LEADS_NOTIFY_EMAIL=andrerevolution14@gmail.com        # onde recebe o aviso de cada lead
# (alternativa sem Resend: SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM)

# --- Meta Pixel + Conversions API ---
NEXT_PUBLIC_META_PIXEL_ID=979841341182458   # já é o valor por omissão no código
META_CAPI_ACCESS_TOKEN=EAAG...
# META_EXCLUDE_PHONES=912345678,936000000   # números de teste que nunca contam como Lead (o do André já está excluído)
# META_TEST_EVENT_CODE=TEST12345   # só durante testes no Events Manager; apagar depois
# META_GRAPH_VERSION=v24.0

# --- SMS (opcional, Twilio) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=DomaineXXV            # remetente alfanumérico (máx. 11) ou número +351...
# SMS_ON_NEW_LEAD=true              # também envia SMS de confirmação a cada nova lead
